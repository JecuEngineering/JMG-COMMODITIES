VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Prefer the publishable key from Supabase → Settings → API Keys
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Or the legacy anon JWT (eyJ...)
# VITE_SUPABASE_ANON_KEY=eyJ...

# Public site origin, used for canonical/og:url tags and the generated sitemap.xml
# e.g. https://jmgcommodities.com (no trailing slash)
# VITE_SITE_URL=https://YOUR_DOMAIN
